{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": false,
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2023",
    "skipLibCheck": true
  },
  "include": ["**/*.ts", "**/*.tsx", "**/*.mjs"]
}
